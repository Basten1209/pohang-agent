{
  "name": "run2-guryongpo-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port ${PORT:-3000}",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "format": "prettier --write src tests",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "seed:images": "node --env-file-if-exists=.env scripts/seed-images.mjs",
    "seed:community": "node --env-file-if-exists=.env scripts/seed-demo-community.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.86",
