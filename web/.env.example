# Copy to .env (local) or set in Vercel / the GCP VM. Never prefix these with VITE_:
# that would bundle them into the browser.

# OpenAI — without a key the same agent harness runs on the rule-based model.
OPENAI_API_KEY=
# Default comes from config (`agent.model`, seed: gpt-6-luna). Override per deployment.
OPENAI_MODEL=

# E-UM digital twin (pohang-eum.kr → 마이페이지 → 나의 API → 인증키). Encoded or decoded form both work.
EUM_SERVICE_KEY=
# Device id for INT_S01_004 (대기환경 실시간·단일). 1–24 respond; which is nearest Guryongpo is unconfirmed.
EUM_AIR_DEVICE_ID=1

# Storage. Unset → PGlite (embedded Postgres): `.data/pglite` in dev, in-memory in production.
# Set for a real PostgreSQL (Neon/Supabase on Vercel, or Postgres on GCP).
DATABASE_URL=
# Persist PGlite to disk in production (e.g. on the GCP VM): /data/pglite
PGLITE_DIR=

# Signs plan-change approvals so a client cannot forge one. Any long random string;
# defaults to a value derived from OPENAI_API_KEY. Keep it the same across instances.
AGENT_APPROVAL_SECRET=
